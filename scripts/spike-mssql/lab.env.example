# Lab values for the SQL Server spike. Copy to local/lab.env (ignored by git)
# and fill in. The run scripts and decrypt-tde.py read that file; variables
# already in the environment win.
#
# Where the Linux lab is, for the person running the scripts. Not read by them.
LAB_HOST=CHANGE_ME
LAB_SSH=CHANGE_ME
# sa of the throwaway container.
MSSQL_SA_PASSWORD=CHANGE_ME
# Database master key in master, and the private key of the TDE certificate backup.
MSSQL_DMK_PASSWORD=CHANGE_ME
TDE_PVK_PASSWORD=CHANGE_ME
