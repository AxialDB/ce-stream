# Example config. adapter = mysql (below) or mongo (see the commented block).
# Copy to ce-stream.toml (gitignored) and set password.
#
# Production: run without --max-events (continuous). Prefer a replica host.
# Columns: set binlog_row_metadata=FULL on MySQL for real names (not col_0).

[source]
adapter = "mysql"
source_id = "mysql://127.0.0.1:3306/ce-stream"
host = "127.0.0.1"
port = 3306
user = "ce_stream"
password = "CHANGE_ME"
server_id = 19001
tls = true
# full = before/after images; signal = op only
payload_mode = "full"
# row = one CloudEvent per message after commit; transaction = one envelope per commit
delivery_unit = "row"
# Bounded queue; reader blocks when sink is slow (no drops)
queue_capacity = 64

# Include-list only (client-side filter on binlog stream)
include_tables = ["ce_stream_spike.t1"]
# include_tables = ["demo_perf.orders"]

[checkpoint]
path = ".ce-stream/checkpoint.json"

[sink]
# stdout | http
kind = "stdout"
# kind = "http"
# url = "http://127.0.0.1:18080/events"
# Wire format: json (default) | avro — see docs/avro.md
# Row mode + avro  -> ce-stream.cloudevent.v1 per message
# Transaction mode + avro -> ce-stream.committed-transaction.v1 per commit
format = "json"

# MongoDB 8.0+ replica set. Post-images: collMod <coll> with changeStreamPreAndPostImages.
# seed = true copies each include_tables collection, then tails from that cluster time.
# sink.format = "avro" encodes row events as cloudevent-v1 and commits that carry a
# position as committed-transaction-v2. MySQL commits stay on v1.
#
# [source]
# adapter = "mongo"
# source_id = "mongo://127.0.0.1:27017/app"
# uri = "mongodb://127.0.0.1:27017/?replicaSet=rs0"
# database = "app"
# full_document = "required"
# seed = false
# payload_mode = "full"
# delivery_unit = "transaction"
# queue_capacity = 64
# include_tables = ["app.orders"]
